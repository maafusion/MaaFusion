# Copy to .env and fill in values from:
# Supabase Dashboard > Project > Settings > API
#
# Both are required - src/lib/supabaseClient.ts throws at startup without them.
# These are inlined into the client bundle at build time, so use the
# publishable (anon) key only - never the secret / service_role key.
# On Vercel, set the same two variables and redeploy.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
